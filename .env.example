# ============================================================
# The Herta Voice Assistant — пример конфигурации.
# Скопируй в `.env` (`cp .env.example .env`) и впиши свои значения.
# Файл `.env` в .gitignore и не должен коммититься.
#
# Ключи API можно не вписывать сюда вовсе: кнопка НАСТРОЙКИ в окне
# кладёт их в системное хранилище учётных данных. Если ключ задан и там,
# и здесь, побеждает хранилище — так задумано, подробности в README.
# ============================================================

# ---------- Активный провайдер LLM ----------
# Допустимые значения: ollama | cerebras | deepseek | google_ai
LLM_PROVIDER=ollama

# Локальные адреса мимо системного прокси. Нужно, если включён VPN/SOCKS:
# иначе Ollama на localhost недостижима.
NO_PROXY=127.0.0.1,localhost

# ---------- Ollama (локально) ----------
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TEMPERATURE=0.55
# Системный префикс Герты (персона + примеры речи) занимает ~7000 токенов.
# В окно 2048 он не влезает и молча обрезается — модель получает огрызок
# персоны и отвечает не в характере. При тесном окне Герта сама переходит
# на компактную версию персоны и говорит об этом.
# Замерено на RTX 3060 6 ГБ с qwen2.5:7b:
#   8192  -> 4254 МиБ VRAM, персона компактная
#   16384 -> 4053 МиБ VRAM, персона полная, но больше слоёв уходит на CPU
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=10m

# ---------- Cerebras (cloud) ----------
# Ключ: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_TEMPERATURE=0.55
# 700 обрывало таблицы и длинные листинги на полуслове.
CEREBRAS_MAX_TOKENS=4000
CEREBRAS_TIMEOUT_SECONDS=60

# ---------- DeepSeek / OpenRouter (опционально) ----------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Для OpenRouter:
# DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1

# ---------- Google AI Studio (опционально, нужен для --live-voice) ----------
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemma-3-27b-it
GOOGLE_AI_LIVE_MODEL=gemini-3.1-flash-live-preview
GOOGLE_AI_LIVE_API_VERSION=v1beta

# ---------- STT / TTS / голос ----------
STT_PROVIDER=whisper
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
# Для cuda ставь float16, для cpu — int8.
WHISPER_COMPUTE_TYPE=int8

EDGE_TTS_ENABLED=true
# Базовый голос для RVC: cpu | cuda.
SILERO_TTS_DEVICE=cpu

# ---------- RVC (оригинальный голос Герты, опционально) ----------
RVC_TTS_ENABLED=false
RVC_BACKEND=persistent
RVC_WARM_UP=true
RVC_BASE_TTS=silero
# Пути к Applio и модели на твоей машине:
RVC_APPLIO_ROOT=
RVC_APPLIO_PYTHON=
RVC_MODEL_PATH=
RVC_INDEX_PATH=
RVC_PITCH=0
RVC_F0_METHOD=rmvpe

# ---------- Короткая память диалога ----------
MEMORY_ENABLED=true
MAX_HISTORY_MESSAGES=8

# ---------- Долговременная память (факты между сессиями) ----------
LONG_MEMORY_ENABLED=true
LONG_MEMORY_PATH=data/long_memory.json
LONG_MEMORY_MAX_FACTS=200
# Auto-extract: каждые N реплик Герта делает доп LLM-запрос и сама извлекает
# стабильные факты. Можно отключить, чтоб экономить вызовы.
LONG_MEMORY_AUTO_EXTRACT=true
LONG_MEMORY_AUTO_EXTRACT_EVERY_TURNS=6

# ---------- Wake word ----------
# В режиме --voice Герта отвечает только когда слышит своё имя.
# В течение WAKEWORD_FOLLOW_UP_SECONDS после ответа можно говорить без имени.
WAKEWORD_ENABLED=true
# Режимы: text (только пост-STT матчинг) | porcupine | both
WAKEWORD_MODE=text
WAKEWORD_PHRASES=герта,герто,великая герта,эй герта,слушай герта,herta,hertha
WAKEWORD_FOLLOW_UP_SECONDS=60
# Заполняй только если WAKEWORD_MODE=porcupine или both:
# Ключ: https://console.picovoice.ai/
# .ppn для русского "Герта": Picovoice Console → Wake Words → Custom
PORCUPINE_ACCESS_KEY=
PORCUPINE_KEYWORD_PATHS=
PORCUPINE_SENSITIVITY=0.5

# ---------- Web search (Tavily) ----------
# Триггеры: "найди в интернете X", "погугли X", "новости про X",
# "какая погода в X", "что такое X", "кто такой X", "когда выходит X".
# Ключ: https://tavily.com/ (1000 запросов/мес бесплатно).
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=15
WEB_SEARCH_DEPTH=basic
# Если true — Герта делает доп LLM-вызов и пересказывает результаты своим голосом.
# Если false — зачитывает сырой ответ Tavily (быстрее, но "Герта" исчезает).
WEB_SEARCH_FOLLOWUP_IN_CHARACTER=true

# ---------- Code tools (mypy + ruff) ----------
# Голосовые команды: "проверь типы в X", "линтуй X".
# Самопроверка: после каждого ответа с кодом ≥ N строк прогоняет mypy+ruff
# и просит Герту переписать с учётом замечаний. Стоит +1 LLM-вызов.
CODE_TOOLS_ENABLED=false
CODE_TOOLS_PROJECT_ROOT=.
# 30 не хватает на файлах с PySide6: mypy сначала строит кэш.
CODE_TOOLS_TIMEOUT_SECONDS=180
CODE_TOOLS_SELF_CHECK=false
CODE_TOOLS_SELF_CHECK_MAX_SNIPPETS=2
CODE_TOOLS_SELF_CHECK_MIN_LINES=3

# ---------- Telegram-мост ----------
# Герта отвечает людям в Telegram. Системные действия через этот канал
# недоступны никому — иначе гости управляли бы твоей машиной.
# Токен: @BotFather → /newbot
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Свой chat id узнаешь, написав боту /whoami.
TELEGRAM_OWNER_CHAT_ID=
# Пусто = отвечать всем. Или список id через запятую.
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_HISTORY_MESSAGES=12
TELEGRAM_COOLDOWN_SECONDS=2
TELEGRAM_GUEST_WEB_SEARCH=false
# Голосовые: входящие распознаёт Whisper, ответ озвучивается голосом Герты.
# Whisper и RVC грузятся лениво — до первого голосового VRAM не занимают.
TELEGRAM_VOICE_ENABLED=false
# mirror — голосом только в ответ на голосовое; always — всегда; never — никогда.
TELEGRAM_VOICE_REPLY_MODE=mirror
TELEGRAM_VOICE_MAX_CHARS=700
TELEGRAM_VOICE_MAX_INPUT_SECONDS=180
# История переписок на диске — переживает перезапуск моста.
TELEGRAM_PERSIST_HISTORY=true
TELEGRAM_STORE_PATH=data/telegram_chats.sqlite3
TELEGRAM_STORE_MAX_MESSAGES=200
# Если api.telegram.org блокируется провайдером: socks5://127.0.0.1:10808
TELEGRAM_PROXY=

# ---------- Зрение ----------
# Локальная мультимодальная модель в Ollama: картинки не уходят в облако.
# Работает и на фото в Telegram, и на команду «что у меня на экране».
# qwen2.5vl:3b влезает в 6 ГБ VRAM рядом с Whisper и RVC; 7b — уже нет.
VISION_ENABLED=false
VISION_MODEL=qwen2.5vl:3b
VISION_TIMEOUT_SECONDS=180
# 1 — основной монитор, 0 — все сразу.
VISION_MONITOR_INDEX=1

# ---------- Интеграция с редактором ----------
# «Открой main.py», «перейди к ошибке», «прогони тесты».
# Находки mypy/ruff/pytest запоминаются, поэтому переход к ошибке
# работает сразу после проверки. Редактор: auto | vscode | intellij.
IDE_ENABLED=false
IDE_EDITOR=auto
IDE_PROJECT_ROOT=.
IDE_TEST_TIMEOUT_SECONDS=300

# ---------- Терминал по белому списку ----------
# Только перечисленные в коде команды (git status/log/diff, pip list, mypy,
# ruff, pytest…) и только после подтверждения в окне. Оболочка не участвует:
# пайпы, && и подстановки не сработают. Команды, меняющие состояние
# (push, install, reset), запрещены даже для разрешённых программ.
SHELL_COMMANDS_ENABLED=false
SHELL_WORKING_DIR=.
SHELL_TIMEOUT_SECONDS=60

# ---------- Управление компьютером ----------
# Обратимые действия: запуск программ, громкость и медиа, буфер обмена,
# переключение окон, поиск файлов. Ничего не удаляет и не перезаписывает.
SYSTEM_CONTROL_ENABLED=false

# ---------- Глобальные хоткеи ----------
# Работают из любого окна. Системный хук клавиатуры на Windows иногда
# требует запуска от администратора — если не поднялись, Герта скажет.
HOTKEYS_ENABLED=false
HOTKEY_SUMMON=ctrl+shift+h
# Диктовка: удерживай, говори, отпусти — текст напечатается туда, где курсор.
HOTKEY_DICTATION=ctrl+shift+d
HOTKEY_VOICE_TOGGLE=ctrl+shift+v
# Выдели код в редакторе и нажми — Герта разберёт фрагмент.
HOTKEY_ASK_SELECTION=ctrl+shift+a

# ---------- Профили собеседников ----------
# У Герты складывается мнение о каждом человеке: раз в N обращений она
# пересматривает его отдельным вызовом модели. Впечатление переписывается,
# а не копится, поэтому неудачный разговор не закостеневает навсегда.
# Хранится по файлу на человека, отдельно от личной памяти владельца.
PEOPLE_ENABLED=false
PEOPLE_DIR=data/people
PEOPLE_IMPRESSION_EVERY_TURNS=6

# ---------- Системные действия (открыть браузер/VS Code, создать .txt) ----------
SYSTEM_ACTIONS_ENABLED=false
SYSTEM_ACTIONS_DOCUMENT_DIR=desktop
SYSTEM_ACTIONS_REGISTRY_PATH=data/system_actions_registry.json
SYSTEM_ACTIONS_BROWSER_HOME_URL=https://www.google.com
SYSTEM_ACTIONS_VSCODE_COMMAND=code
SYSTEM_ACTIONS_VSCODE_OPEN_WORKSPACE=true
